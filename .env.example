# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Google Maps API
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
# Fase 2 enriquecimiento: true = NO descargar fotos de Google (solo IA). false = descargar fotos (coste)
SKIP_GOOGLE_PHOTOS=true

# OpenAI API
OPENAI_API_KEY=your_openai_api_key_here
# Modelo para descripciones de lugares (Fase 2 y regeneraciones). Ej: gpt-5.6-terra
# Si no se define, se usa gpt-4o-mini
OPENAI_ENRICHMENT_MODEL=gpt-5.6-terra

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_xxxxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxx

# Stripe Price IDs (obtener después de crear productos en Stripe)
STRIPE_PREMIUM_MONTHLY_PRICE_ID=price_xxxxx
STRIPE_PREMIUM_YEARLY_PRICE_ID=price_xxxxx
STRIPE_ADMIN_MONTHLY_PRICE_ID=price_xxxxx

# Stripe Webhook Secret
STRIPE_WEBHOOK_SECRET=whsec_xxxxx

# Mapbox (opcional - para mapas alternativos)
NEXT_PUBLIC_MAPBOX_TOKEN=your_mapbox_token_here

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
